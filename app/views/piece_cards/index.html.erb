<ul>
  <li>These are all the chess pieces in the game</li>
  <li>Pieces that survive a game get promoted</li>
  <li>Upgrade pieces using upgrade points</li>
  <li>Earn upgrade points by capturing pawns</li>
</ul>
<fieldset class="chess-set">
  <legend>Piece Cards</legend>
  <ul>
    <% @piece_cards.each do |piece_card| %>
      <li>
        <span class="name"><%= piece_card.name %></span>
        <span class="rank"><%= piece_card.rank_name %></span>
        <span class="symbols">
          <%= piece_card.host_symbol %>
          <%= piece_card.guest_symbol %>
        </span>
      </li>
    <% end %>
  </ul>
</fieldset>
