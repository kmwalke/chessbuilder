<p style="color: green"><%= notice %></p>

<% content_for :title, "Users" %>

<h1>Users</h1>

<table id="users">
  <thead>
  <tr>
    <td>Name</td>
  </tr>
  </thead>
  <% @users.each do |user| %>
    <tr>
      <td>
        <%= link_to user.name, user %>
      </td>
    </tr>
  <% end %>
</table>

<%= link_to "New user", new_user_path %>
