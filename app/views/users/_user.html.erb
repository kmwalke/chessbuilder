<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

  <div>
    <strong>Role:</strong>
    <%= user.role %>
  </div>

  <div>
    <strong>Motto:</strong>
    <%= user.motto %>
  </div>

  <div>
    <strong>Level:</strong>
    <%= user.level %>
  </div>

</div>
