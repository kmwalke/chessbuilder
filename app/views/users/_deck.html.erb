<fieldset class="chess-set">
  <legend>Chess Set</legend>
  <strong>Strength: <%= @user.deck.strength %></strong>
  <ul>
    <% @user.deck.piece_cards.each do |piece_card| %>
      <li>
        <span class="name"><%= piece_card.name %></span>
        <span class="rank"><%= piece_card.rank_name %></span>
        <span class="symbols">
          <%= piece_card.host_symbol %>
          <%= piece_card.guest_symbol %>
        </span>
      </li>
    <% end %>
  </ul>
</fieldset>
