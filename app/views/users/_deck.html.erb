<fieldset>
  <legend>Deck</legend>
  <span><%= @user.deck.piece_cards.count %> piece cards</span>
  <table>
    <thead>
    <tr>
      <td>Level</td>
      <td>Name</td>
      <td>Host</td>
      <td>Guest</td>
    </tr>
    </thead>
    <% @user.deck.piece_cards.each do |piece_card| %>
      <tr>
        <td><%= piece_card.level %></td>
        <td><%= piece_card.name %></td>
        <td><%= piece_card.host_symbol %></td>
        <td><%= piece_card.guest_symbol %></td>
      </tr>
    <% end %>
  </table>
</fieldset>
