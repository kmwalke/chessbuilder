<fieldset>
  <legend>Deck</legend>
  <span><%= @user.deck.piece_cards.count %> piece cards</span>
  <ul>
    <% @user.deck.piece_cards.each do |piece_card| %>
      <li>
        <fieldset>
          <legend><%= piece_card.name %></legend>
          <span>Level <%= piece_card.level %></span>
        </fieldset>
      </li>
    <% end %>
  </ul>
</fieldset>
