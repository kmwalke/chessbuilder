<p style="color: green"><%= notice %></p>

<h1><%= @game.name %></h1>

<%= form_with url: move_game_path do |form| %>
<!--  TODO: big radio button in the background to deselect any pieces-->
  <%= form.radio_button(nil, nil, id: "nil_piece_select", name: "move[piece_id]") %>
  <%= form.label 'nil_piece_select', 'no piece', class: 'nil'  %>
  <table class="board">
    <% (1..@game.board_height).sort.reverse.each do |y| %>
      <tr>
        <% (1..@game.board_width).each do |x| %>
          <% position = algebraic_notation(x, y) %>
          <% piece = piece(position) %>
          <td title="<%= position %>" id="<%= position %>">
            <% if piece %>
              <%= form.label "#{position}_piece_select", piece.symbol %>
              <%= form.radio_button(
                    nil,
                    "{ \"piece_id\": #{piece.id}, \"from\": \"#{position}\", \"to\": \"c4\" }",
                    id: "#{position}_piece_select",
                    name: "move[data]")
              %>
              <div class="possible-moves">
                <%= piece.name %>
              </div>
<!--              TODO: WHen selected, open overlay with possible moves-->
<!--              Overlay is whole board, put radio buttons on each good move-->
<!--              Form is submitted showing the piece and where to move it to-->
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </table>
  <%= form.submit "Move piece" %>
<% end %>

<div>
  <%= link_to "Back to games", games_path %>

  <%= button_to "Destroy this game", @game, method: :delete %>
</div>
