<p style="color: green"><%= notice %></p>

<% content_for :title, "Games" %>

<h1>Games</h1>

<div id="games">
  <ul>
    <% @games.each do |game| %>
      <li>
        <%= link_to game.name, game_path(game) %>
      </li>
    <% end %>
  </ul>
</div>

<% if current_user %>
  <%= link_to "New game", new_game_path %>
<% end %>
